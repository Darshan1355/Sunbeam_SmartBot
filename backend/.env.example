# ==============================================================================
# Sunbeam SmartBot - Backend Environment Configuration
# ==============================================================================

# Server Settings
APP_NAME="Sunbeam SmartBot API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Groq API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Supported Groq Models (e.g. openai/gpt-oss-120b, qwen/qwen3.8-27b, llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=2
GROQ_TEMPERATURE=0.1

# ChromaDB Persistent Path (relative to backend or absolute)
CHROMA_PERSIST_DIR="../data/chroma_db"
